{
  "name": "@listen-fire/s3-files",
  "license": "Apache-2.0",
  "version": "0.12.7",
  "description": "The files slot's module over S3 (`@lf/s3-files`): listen-fire keeps a run's documents in a bucket of AWS S3, Google Cloud Storage (its S3 interoperability endpoint), Cloudflare R2, MinIO or any S3 compatible service, instead of a container's disk. Served as a process listen-fire starts (kind: core, slot: files).",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "bin": {
    "lf-s3-files": "./dist/serve.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "3.649.0",
    "@listen-fire/files-s3": "workspace:^",
    "@listen-fire/module-runtime": "workspace:^"
  },
  "peerDependencies": {
    "@listen-fire/engine-contracts": ">=0.12.0 <1.0.0"
  },
  "devDependencies": {
    "@listen-fire/engine-contracts": "workspace:^",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "files-s3": "workspace:@listen-fire/files-s3@*",
    "module-runtime": "workspace:@listen-fire/module-runtime@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/s3-files"
  },
  "files": [
    "dist",
    "lf-external.yaml"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "lf-s3-files": "./dist/serve.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    }
  }
}
