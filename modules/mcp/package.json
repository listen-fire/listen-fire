{
  "name": "@listen-fire/mcp",
  "license": "Apache-2.0",
  "version": "0.12.11",
  "description": "Any remote MCP server as a module: its tools, read from the server when a connection is described, become types a movement writes (a tool that changes things) or reads (a read-only tool). Streamable HTTP only; signed in with a token or OAuth. Loaded in process by the platform, served by serve-module everywhere else.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/module-kit": "workspace:^",
    "@modelcontextprotocol/sdk": "1.32.1"
  },
  "peerDependencies": {
    "@listen-fire/engine": ">=0.12.0 <1.0.0",
    "@listen-fire/engine-contracts": ">=0.12.0 <1.0.0",
    "@listen-fire/movement-lang": ">=0.12.0 <1.0.0"
  },
  "devDependencies": {
    "@listen-fire/engine": "workspace:^",
    "@listen-fire/engine-contracts": "workspace:^",
    "@listen-fire/movement-lang": "workspace:^",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "module-kit": "workspace:@listen-fire/module-kit@*",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "movement-lang": "workspace:@listen-fire/movement-lang@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/mcp"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    }
  }
}
