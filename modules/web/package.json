{
  "name": "@listen-fire/web",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.8",
  "description": "The six bundled plugins (fetch a page, scan a message for links worth fetching, find a person's profile, read what they are doing now, find a company's own site, research a subject) as one plugin module. Loaded in process by the platform with its own tools, served by serve-module everywhere else with the standalone tools (Anthropic, Bright Data, a plain fetch).",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "jest --config jest.config.cjs",
    "bench": "node --require ../../packages/module-kit/node_modules/tsx/dist/cjs/index.cjs bench/hosted_bench.ts",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/anthropic": "workspace:^",
    "@listen-fire/engine": "workspace:^",
    "@listen-fire/engine-contracts": "workspace:^",
    "@listen-fire/file-text": "workspace:^",
    "@listen-fire/module-kit": "workspace:^",
    "@listen-fire/movement-lang": "workspace:^",
    "html-to-text": "9.0.5",
    "jspdf": "4.2.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "file-text": "workspace:@listen-fire/file-text@*",
    "module-kit": "workspace:@listen-fire/module-kit@*",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "movement-lang": "workspace:@listen-fire/movement-lang@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/web"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./research": {
        "types": "./dist/research/index.d.ts",
        "default": "./dist/research/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "research": [
          "dist/research/index.d.ts"
        ],
        "*": [
          "dist/*",
          "*"
        ]
      }
    },
    "tag": "next"
  }
}
