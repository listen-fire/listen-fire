{
  "name": "@listen-fire/document-ai",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.6",
  "description": "The ocr slot's module on Google Document AI (`@lf/document-ai`): a scanned PDF's or an image's text, online for short files and batched through a Cloud Storage bucket for long ones, exactly as the platform reads them (packages/ocr-google), each read priced per page. Served as a process lf starts (kind: core, slot: ocr).",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "bin": {
    "lf-document-ai": "./dist/serve.js"
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/engine-contracts": "workspace:^",
    "@listen-fire/module-runtime": "workspace:^",
    "@listen-fire/ocr-google": "workspace:^",
    "unpdf": "1.8.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "module-runtime": "workspace:@listen-fire/module-runtime@*",
    "tsx": "4.21.0",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/document-ai"
  },
  "files": [
    "dist",
    "lf-external.yaml"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
      "lf-document-ai": "./dist/serve.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    },
    "tag": "next"
  }
}
