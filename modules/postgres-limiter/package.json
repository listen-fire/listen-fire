{
  "name": "@listen-fire/postgres-limiter",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.9",
  "description": "The limiter slot kept in Postgres, so many lf workers share one count of calls and held places instead of each allowing the full limit. A process module lf starts (kind: core, slot: limiter); see lf-external.yaml. The contract suite runs in apps/cli",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/engine": "workspace:^",
    "pg": "8.12.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "@types/pg": "8.11.9",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/postgres-limiter"
  },
  "files": [
    "dist",
    "lf-external.yaml"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    },
    "tag": "next"
  }
}
