{
  "name": "@listen-fire/anthropic",
  "license": "Apache-2.0",
  "version": "0.12.6",
  "description": "The models slot's module for Claude (`@lf/anthropic`): the client every model call goes through (chat, structured output, the tool loop, web chat with Anthropic's hosted search and fetch), the chat seam a provider stands behind, Anthropic's API on a key the caller holds, the price table every call is billed from (prices.json, which the Rust listen-fire embeds too), and the extraction and `AI()` clients the engine's models slot is filled with.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "type": "commonjs",
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
    "exponential-backoff": "3.1.1",
    "jsonrepair": "3.8.0",
    "zod": "4.1.12"
  },
  "peerDependencies": {
    "@listen-fire/engine": ">=0.12.0 <1.0.0"
  },
  "devDependencies": {
    "@listen-fire/engine": "workspace:^",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/anthropic"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    }
  }
}
