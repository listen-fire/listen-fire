{
  "name": "@listen-fire/email",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.8",
  "description": "Inbound email (Mailgun or Resend: the message, its fields and attachments, the doors' signature checks) and the outbound senders, as a module. Loaded in process by the platform, served by serve-module everywhere else.",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node ../../scripts/check-module-boundary.cjs",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/engine": "workspace:^",
    "@listen-fire/engine-contracts": "workspace:^",
    "@listen-fire/module-kit": "workspace:^",
    "form-data": "4.0.0",
    "html-to-text": "9.0.5",
    "mailgun.js": "10.2.3",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/html-to-text": "9.0.4",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "module-kit": "workspace:@listen-fire/module-kit@*",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "modules/email"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "*": [
          "dist/*",
          "*"
        ]
      }
    },
    "tag": "next"
  }
}
