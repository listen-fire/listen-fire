crm = connect attio using henry_attio

# A company created in Attio, or renamed, gets a description; the write finds
# it by name, so it updates that record rather than making another. The write
# comes back from Attio as a change to Description, which this listen does not
# take, so it never loops.
function stamp(c: <crm-[:CompanyChange]->>) {
  c-[company:Company]-> {
    write crm-[:Companies]-> {
      unique by (Name)
      Name: company.Name
      Description: "Seen by lf"
    }
  }
}

listen to crm-[:Companies]->-[c:Changes WHERE c.Kind == "created" OR c.Field == "Name"]-> fire stamp
