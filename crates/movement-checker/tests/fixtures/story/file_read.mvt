import { `@lf/manual` as manual, `@lf/attio` as attio } from adapters
import { acme } from credentials

runs = connect manual
crm  = connect attio using acme

function `Cut A Document`(go: <runs-[:Invocation]->>) {
  go-[f:Files]-> {
    text   = File.read(f.File)
    pieces = Text.chunks(coalesce(text, ""), { size: 40000, overlap: 2000 })
    found  = extract(pieces, node Company: "each company named in this text" { name: <text> "the company's name" })
    map(found, (c) => {
      write crm-[:Companies]-> {
        unique by (FUZZY `Name`)
        Name: c.name
      }
    })
  }
}

function `Intake Documents`(go: <runs-[:Invocation]->>) {
  docs    = go-[:Files]->.File
  pieces  = Text.chunks(coalesce(File.read(first(docs)), ""), { size: 40000, overlap: 2000 })
  write crm-[:Companies]-> { Name: coalesce(first(pieces), "untitled") }
}
