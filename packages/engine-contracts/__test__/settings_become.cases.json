{
  "about": "A module's listenSettingsBecome judged against what it describes, by engine-contracts unreadableSettingsBecome and crates/lf schema.rs unreadable_settings_become, word for word. A base the connection is positioned at stands on the path's first hop.",
  "entries": [
    { "typeId": "base", "displayName": "Base", "collectionName": "Bases", "writable": false, "readable": true },
    { "typeId": "note", "displayName": "Notification", "collectionName": "Notifications", "writable": false, "readable": false, "listenable": true }
  ],
  "positioned": [{ "typeId": "table", "displayName": "Table", "collectionName": "Tables", "writable": false, "readable": true }],
  "descriptors": {
    "base": { "typeId": "base", "displayName": "Base", "fields": [], "references": [{ "fieldId": "tables", "name": "Tables", "targetTypeId": "table", "cardinality": "many", "direction": "outgoing" }] },
    "table": { "typeId": "table", "displayName": "Table", "fields": [], "references": [{ "fieldId": "changes", "name": "Changes", "targetTypeId": "change", "cardinality": "many", "direction": "outgoing" }] },
    "change": { "typeId": "change", "displayName": "Change", "fields": [], "references": [] },
    "note": { "typeId": "note", "displayName": "Notification", "fields": [], "references": [] }
  },
  "cases": [
    {
      "name": "a root edge and its key",
      "become": { "path": ["Notifications"], "aliases": ["n"], "paramFrom": "Notification", "keys": { "events": { "hop": 0, "field": "Reason", "op": "in" } } },
      "refusal": null
    },
    {
      "name": "a path down two edges",
      "become": { "path": ["Bases", "Tables", "Changes"], "aliases": ["b", "t", "c"], "keys": { "base": { "hop": 0, "field": "Id", "op": "eq" }, "becomes": { "hop": 2, "field": "New", "op": "eq" } } },
      "refusal": null
    },
    {
      "name": "a positioned connection starts below its position",
      "positioned": true,
      "become": { "path": ["Bases", "Tables", "Changes"], "aliases": ["b", "t", "c"], "keys": { "table": { "hop": 1, "field": "Id", "op": "eq" } } },
      "refusal": null
    },
    {
      "name": "an alias short",
      "become": { "path": ["Bases", "Tables"], "aliases": ["b"], "keys": {} },
      "refusal": "'listenSettingsBecome' gives 1 aliases for a path of 2 edges: give one per edge"
    },
    {
      "name": "a hop past the path",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "events": { "hop": 1, "field": "Reason", "op": "in" } } },
      "refusal": "'listenSettingsBecome' maps 'events' to hop 1, past the last of its 1 edges"
    },
    {
      "name": "a comparison on no field",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "events": { "hop": 0, "op": "in" } } },
      "refusal": "'listenSettingsBecome' maps 'events' by 'in' but names no field to compare"
    },
    {
      "name": "a type key names no field",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "payload": { "hop": 0, "op": "type" } } },
      "refusal": null
    },
    {
      "name": "a path that starts at no root collection",
      "become": { "path": ["Inbox"], "aliases": ["i"], "keys": {} },
      "refusal": "'listenSettingsBecome' starts nowhere: none of Inbox is a root collection (the root collections: Bases, Notifications)"
    },
    {
      "name": "an edge its type does not have",
      "become": { "path": ["Bases", "Sheets", "Changes"], "aliases": ["b", "s", "c"], "keys": {} },
      "refusal": "'listenSettingsBecome' names 'Sheets' after 'Bases', which is no edge off 'Base' (its edges: Tables)"
    },
    {
      "name": "what leaving a key out meant, one value or a list",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "key": { "hop": 0, "field": "Key", "op": "eq", "absent": "", "lowercase": true }, "events": { "hop": 0, "field": "Reason", "op": "in", "absent": ["mention", "assign"], "values": { "mention": "mentioned", "assign": "assigned" } } } },
      "refusal": null
    },
    {
      "name": "an absent value on a type key",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "payload": { "hop": 0, "op": "type", "absent": "Payment" } } },
      "refusal": "'listenSettingsBecome' gives 'payload' an absent value, but a 'type' key compares no field"
    },
    {
      "name": "absent values an eq key cannot compare",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "events": { "hop": 0, "field": "Reason", "op": "eq", "absent": ["mention", "assign"] } } },
      "refusal": "'listenSettingsBecome' gives 'events' 2 absent values, but an 'eq' key compares one"
    },
    {
      "name": "an absent value its values do not spell",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "events": { "hop": 0, "field": "Reason", "op": "in", "absent": ["mention", "assign"], "values": { "mention": "mentioned" } } } },
      "refusal": "'listenSettingsBecome' gives 'events' the absent value \"assign\", which its values do not spell"
    },
    {
      "name": "lowercase on a key that compares a field",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "key": { "hop": 0, "field": "Reason", "op": "eq", "lowercase": true } } },
      "refusal": null
    },
    {
      "name": "lowercase on a type key",
      "become": { "path": ["Notifications"], "aliases": ["n"], "keys": { "kind": { "hop": 0, "op": "type", "lowercase": true } } },
      "refusal": "'listenSettingsBecome' gives 'kind' 'lowercase: true', but a 'type' key compares no text"
    }
  ],
  "manifestReads": {
    "about": "A manifest's listenSettingsBecome as it is read, by WireListenDeclarations and crates/lf externals.rs settings_become, word for word: unknown keys stripped, the parsed value kept, an empty name refused.",
    "cases": [
      {
        "name": "unknown keys are stripped at both levels",
        "raw": { "path": ["Notifications"], "aliases": ["n"], "extra": 1, "keys": { "events": { "hop": 0, "field": "Reason", "op": "in", "defaults": ["x"] } } },
        "read": { "path": ["Notifications"], "aliases": ["n"], "keys": { "events": { "hop": 0, "field": "Reason", "op": "in" } } },
        "refusal": null
      },
      {
        "name": "a path of no edges",
        "raw": { "path": [], "aliases": [], "keys": {} },
        "refusal": "listenSettingsBecome.path: expected at least one edge"
      },
      {
        "name": "an empty edge name",
        "raw": { "path": ["Notifications", ""], "aliases": ["n", "m"], "keys": {} },
        "refusal": "listenSettingsBecome.path: expected non-empty edge names"
      },
      {
        "name": "an empty alias",
        "raw": { "path": ["Notifications"], "aliases": [""], "keys": {} },
        "refusal": "listenSettingsBecome.aliases: expected non-empty aliases"
      },
      {
        "name": "an empty paramFrom",
        "raw": { "path": ["Notifications"], "aliases": ["n"], "paramFrom": "", "keys": {} },
        "refusal": "listenSettingsBecome.paramFrom: expected a non-empty string"
      },
      {
        "name": "an empty field",
        "raw": { "path": ["Notifications"], "aliases": ["n"], "keys": { "events": { "hop": 0, "field": "", "op": "in" } } },
        "refusal": "listenSettingsBecome.keys.field: expected a non-empty string"
      },
      {
        "name": "what leaving a key out meant is kept",
        "raw": { "path": ["Emails"], "aliases": ["e"], "keys": { "key": { "hop": 0, "field": "Key", "op": "eq", "absent": "", "lowercase": true }, "events": { "hop": 0, "field": "Kind", "op": "in", "absent": ["a", "b"] } } },
        "read": { "path": ["Emails"], "aliases": ["e"], "keys": { "key": { "hop": 0, "field": "Key", "op": "eq", "absent": "", "lowercase": true }, "events": { "hop": 0, "field": "Kind", "op": "in", "absent": ["a", "b"] } } },
        "refusal": null
      },
      {
        "name": "an absent value that is not text",
        "raw": { "path": ["Emails"], "aliases": ["e"], "keys": { "key": { "hop": 0, "field": "Key", "op": "eq", "absent": 3 } } },
        "refusal": "listenSettingsBecome.keys.absent: expected a text or a list of texts"
      },
      {
        "name": "a lowercase that is not true or false",
        "raw": { "path": ["Emails"], "aliases": ["e"], "keys": { "key": { "hop": 0, "field": "Key", "op": "eq", "lowercase": "yes" } } },
        "refusal": "listenSettingsBecome.keys.lowercase: expected true or false"
      }
    ]
  }
}
