{
  "name": "@listen-fire/engine-contracts",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.6",
  "description": "The contracts the movement engine speaks: the tenant id, the host families and entry-point inputs, the parked state, file descriptors, the adapter protocol, the adapter contract and its manifest, the catalog's schema types and positions, the Expression vocabulary, plugins as data and the model names. Runtime-neutral: no Node import, no ambient types.",
  "engines": {
    "node": "22.20.0"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit && node __embed_smoke__/check.cjs",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./conformance": "./conformance/index.ts",
    "./slots": "./slots/index.ts",
    "./package.json": "./package.json",
    "./*": "./*.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/movement-lang": "workspace:^",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "20.16.5",
    "movement-lang": "workspace:@listen-fire/movement-lang@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/engine-contracts"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./conformance": {
        "types": "./dist/conformance/index.d.ts",
        "default": "./dist/conformance/index.js"
      },
      "./slots": {
        "types": "./dist/slots/index.d.ts",
        "default": "./dist/slots/index.js"
      },
      "./*": {
        "types": "./dist/*.d.ts",
        "default": "./dist/*.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "conformance": [
          "dist/conformance/index.d.ts"
        ],
        "slots": [
          "dist/slots/index.d.ts"
        ],
        "*": [
          "dist/*",
          "*"
        ]
      }
    },
    "tag": "next"
  }
}
