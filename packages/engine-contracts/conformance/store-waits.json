        { "do": "park", "run": "run-1", "wait": "w", "address": "s1" },
        { "do": "log", "arrivals": [{ "edge": "Comments", "key": "thread:c1", "identity": "k1", "version": "1" }], "wakes": [{ "run": "run-1", "wait": "w", "address": "s1" }] },
