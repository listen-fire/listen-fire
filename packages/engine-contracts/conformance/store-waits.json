        { "do": "arrivals", "wait": "w", "gone": false, "arrivals": [{ "identity": "k1", "version": "1" }] },
        { "do": "note", "wait": "w", "identity": "k1", "version": "1", "matched": true, "counts": true, "leaf": "s1" },
        { "do": "finish", "run": "run-1", "address": "s1" },
        { "do": "park", "run": "run-1", "wait": "w", "address": "s1" },
        { "do": "claim", "run": "run-1", "address": "s1" },
        { "do": "arrivals", "wait": "w", "gone": false, "arrivals": [] }
