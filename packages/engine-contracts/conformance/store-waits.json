      ]
    },
    {
      "case": "a note made by a segment resuming a leaf is kept when the leaf finishes, and dropped when the leaf is claimed again after that segment died",
      "steps": [
        { "do": "mark", "as": "m0" },
        { "do": "open", "as": "w", "run": "run-1", "edge": "Comments", "key": "thread:c1", "since": "m0" },
