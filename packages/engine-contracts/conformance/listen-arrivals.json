  "plans": {
    "lunch": {
      "source": "import { chat as chat_module } from adapters; chat = connect chat_module\nfunction tally(i: <chat-[:Interaction]->>) { return i.Id }\nlisten to chat-[h:Channels WHERE h.Name == \"office\"]->-[m:Messages WHERE m.Topic == \"lunch-poll\" AND m.`Posted At` WITHIN 3d]->-[i:Interactions WHERE i.Value != \"skip\"]-> fire tally\n",
      "plan": {
        "adapter": "chat",
        "carries": [
          "Channels",
          "Messages"
        ],
        "connection": "chat",
        "hops": [
          {
            "alias": "h",
            "edge": "Channels",
            "from": "",
            "judged": "arrival",
            "taken": {
              "left": {
                "fieldOnly": true,
                "propertyTypeId": "Name",
                "type": "edge_property"
              },
              "op": "eq",
              "right": {
                "type": "static",
                "value": "office"
              },
              "type": "compare"
            },
            "to": "Channel"
          },
          {
            "alias": "m",
            "checked": {
              "left": {
                "fieldOnly": true,
                "propertyTypeId": "Posted At",
                "type": "edge_property"
              },
              "op": "within",
              "right": {
                "type": "static",
                "value": "3d"
              },
              "type": "compare"
            },
            "edge": "Messages",
            "from": "Channel",
            "judged": "arrival",
            "taken": {
              "left": {
                "fieldOnly": true,
                "propertyTypeId": "Topic",
                "type": "edge_property"
              },
              "op": "eq",
              "right": {
                "type": "static",
                "value": "lunch-poll"
              },
              "type": "compare"
            },
            "to": "Message"
          },
          {
            "alias": "i",
            "checked": {
              "left": {
                "fieldOnly": true,
                "propertyTypeId": "Value",
                "type": "edge_property"
              },
              "op": "neq",
              "right": {
                "type": "static",
                "value": "skip"
              },
              "type": "compare"
            },
            "edge": "Interactions",
            "from": "Message",
            "judged": "arrival",
            "to": "Interaction"
          }
        ],
        "movement": "tally"
      }
    },
