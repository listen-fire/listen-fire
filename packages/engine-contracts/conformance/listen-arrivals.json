  "cases": [
    {"case": "a press on a lunch poll fires", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "office"}, {"Topic": "lunch-poll", "Posted At": "2026-10-30T10:00:00Z"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"fires": true}},
    {"case": "a press on a poll older than 3d skips at Messages", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "office"}, {"Topic": "lunch-poll", "Posted At": "2026-10-27T09:00:00Z"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 1}},
    {"case": "a change of another kind skips at Changes", "plan": "changes", "arrival": {"edge": "Changes", "key": "c2", "landing": {"Id": "c2", "Kind": "updated"}}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 2}},
    {"case": "a press carrying no message is undecided", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "office"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"undecided": "the arrival carries no Messages record, which this listen's filter on it reads"}},
    {"case": "a press carrying null for its message is undecided", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "office"}, null]}, "now": "2026-10-31T10:00:00Z", "verdict": {"undecided": "the arrival carries no Messages record, which this listen's filter on it reads"}},
    {"case": "a pushed press its module did not filter, in another channel, skips at Channels", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "random"}, {"Topic": "lunch-poll", "Posted At": "2026-10-30T10:00:00Z"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 0}},
    {"case": "the same press fires when its module applied the taken parts", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "random"}, {"Topic": "lunch-poll", "Posted At": "2026-10-30T10:00:00Z"}], "takenApplied": true}, "now": "2026-10-31T10:00:00Z", "verdict": {"fires": true}},
    {"case": "a press on another topic its module did not filter skips at Messages", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "office"}, {"Topic": "standup", "Posted At": "2026-10-30T10:00:00Z"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 1}},
    {"case": "a press its module filtered is still checked: an old poll skips at Messages", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1"}, "parents": [{"Name": "random"}, {"Topic": "lunch-poll", "Posted At": "2026-10-27T09:00:00Z"}], "takenApplied": true}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 1}},
    {"case": "a later hop that fails decides over a parent the arrival lacks", "plan": "lunch", "arrival": {"edge": "Interactions", "landing": {"Id": "t1", "Value": "skip"}, "parents": [{"Name": "office"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 2}},
    {"case": "an arrival on another edge skips at the last hop", "plan": "lunch", "arrival": {"edge": "Reactions", "landing": {"Id": "r1"}, "parents": [{"Name": "office"}, {"Topic": "lunch-poll", "Posted At": "2026-10-30T10:00:00Z"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 2}},
    {"case": "a created change fires: the hops the host resolves are not judged here", "plan": "changes", "arrival": {"edge": "Changes", "key": "c1", "landing": {"Id": "c1", "Kind": "created"}}, "now": "2026-10-31T10:00:00Z", "verdict": {"fires": true}},
    {"case": "a press whose value is its message's topic fires", "plan": "echo", "arrival": {"edge": "Interactions", "landing": {"Id": "t1", "Value": "lunch-poll"}, "parents": [{"Name": "office"}, {"Topic": "lunch-poll"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"fires": true}},
    {"case": "a press whose value is not its message's topic skips at Interactions", "plan": "echo", "arrival": {"edge": "Interactions", "landing": {"Id": "t1", "Value": "standup"}, "parents": [{"Name": "office"}, {"Topic": "lunch-poll"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 2}},
    {"case": "a press whose filter reads a message it does not carry is undecided", "plan": "echo", "arrival": {"edge": "Interactions", "landing": {"Id": "t1", "Value": "lunch-poll"}, "parents": [{"Name": "office"}]}, "now": "2026-10-31T10:00:00Z", "verdict": {"undecided": "the arrival carries no Messages record, which this listen's filter on it reads"}},
    {"case": "an unfiltered mail whose taken part reads an owned field is undecided", "plan": "invoices", "arrival": {"edge": "Messages", "landing": {"Id": "m1", "Subject": "invoice 42"}}, "now": "2026-10-31T10:00:00Z", "verdict": {"undecided": "gmail did not apply this listen's filter on Messages to the arrival, and only gmail can evaluate Query"}},
    {"case": "an unfiltered mail that carries the owned field is judged by the value it carries, and fires", "plan": "invoices", "arrival": {"edge": "Messages", "landing": {"Id": "m3", "Subject": "invoice 42", "Query": "from:acme"}}, "now": "2026-10-31T10:00:00Z", "verdict": {"fires": true}},
    {"case": "an unfiltered mail that carries another value of the owned field skips", "plan": "invoices", "arrival": {"edge": "Messages", "landing": {"Id": "m4", "Subject": "invoice 42", "Query": "from:other"}}, "now": "2026-10-31T10:00:00Z", "verdict": {"skips": 0}},
