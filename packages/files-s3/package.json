{
  "name": "@listen-fire/files-s3",
  "license": "Apache-2.0",
  "version": "0.12.0-rc.10",
  "description": "The files slot over S3 or any S3-compatible service (R2, MinIO, Supabase Storage): store, stream, presign and delete a team's files. Its own package, so a deployment that stores no files carries no AWS SDK.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "type": "commonjs",
  "dependencies": {
    "@aws-sdk/client-s3": "3.649.0",
    "@aws-sdk/s3-request-presigner": "3.649.0",
    "@listen-fire/module-runtime": "workspace:^"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "module-runtime": "workspace:@listen-fire/module-runtime@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/files-s3"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "tag": "next",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
