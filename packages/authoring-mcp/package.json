{
  "name": "@listen-fire/authoring-mcp",
  "license": "Apache-2.0",
  "version": "0.12.7",
  "description": "The tools an agent uses to write, check, save and run movements, served over MCP (streamable HTTP, stateless) for one tenant of the host that mounts it. The host supplies its own auth, each tenant's catalog, its store of saved movements and, optionally, its runs; the language half (the handbook, its search, the checker, the digest of connected systems) is this package's.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "exports": {
    ".": "./index.ts",
    "./testing": "./testing.ts",
    "./package.json": "./package.json"
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/handbook": "workspace:^",
    "@modelcontextprotocol/sdk": "1.32.1",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "@listen-fire/engine": ">=0.12.0 <1.0.0",
    "@listen-fire/engine-contracts": ">=0.12.0 <1.0.0",
    "@listen-fire/movement-lang": ">=0.12.0 <1.0.0"
  },
  "devDependencies": {
    "@listen-fire/engine": "workspace:^",
    "@listen-fire/engine-contracts": "workspace:^",
    "@listen-fire/movement-lang": "workspace:^",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "movement-lang": "workspace:@listen-fire/movement-lang@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/authoring-mcp"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./testing": {
        "types": "./dist/testing.d.ts",
        "default": "./dist/testing.js"
      },
      "./package.json": "./package.json"
    },
    "typesVersions": {
      "*": {
        "testing": [
          "dist/testing.d.ts"
        ]
      }
    }
  }
}
