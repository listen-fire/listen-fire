{
  "name": "@listen-fire/ocr-google",
  "license": "Apache-2.0",
  "version": "0.12.3",
  "description": "Reading text out of scanned PDFs with Google Document AI (online for short files, batched through a Cloud Storage bucket for long ones). The OCR half of the file-text reading slot, as its own package so a deployment without OCR carries no Google Cloud SDK.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "type": "commonjs",
  "dependencies": {
    "@google-cloud/documentai": "9.4.0",
    "@google-cloud/storage": "7.12.1",
    "@listen-fire/engine": "workspace:^",
    "exponential-backoff": "3.1.1"
  },
  "devDependencies": {
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/ocr-google"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts"
  }
}
