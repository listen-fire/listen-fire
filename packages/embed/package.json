{
  "name": "@listen-fire/embed",
  "license": "Apache-2.0",
  "version": "0.12.7",
  "description": "The engine embedded in another product's own process, as one host: each tenant's modules connected over its own credentials (loaded in process through the module kit), its movements checked and kept, an event routed to every listen that hears it, and runs that sleep stepped on at each tick. Built on @listen-fire/engine's public entries; its own package so the core does not depend on the module kit.",
  "engines": {
    "node": ">=22.23.4 <23"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "jest --config jest.config.cjs",
    "prepack": "node ../../scripts/build-packages.cjs .",
    "postpack": "node ../../scripts/build-packages.cjs --restore ."
  },
  "main": "index.ts",
  "types": "index.ts",
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/module-kit": "workspace:^"
  },
  "peerDependencies": {
    "@listen-fire/engine": ">=0.12.0 <1.0.0",
    "@listen-fire/engine-contracts": ">=0.12.0 <1.0.0",
    "@listen-fire/movement-lang": ">=0.12.0 <1.0.0"
  },
  "devDependencies": {
    "@listen-fire/engine": "workspace:^",
    "@listen-fire/engine-contracts": "workspace:^",
    "@listen-fire/movement-lang": "workspace:^",
    "@types/jest": "29.5.14",
    "@types/node": "20.16.5",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "module-kit": "workspace:@listen-fire/module-kit@*",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "typescript": "5.5.4"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/listen-fire/listen-fire.git",
    "directory": "packages/embed"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
