# BuildKit reads this file for deploy/lf/Dockerfile (the build context is the
# repository root, which has no .dockerignore of its own).
node_modules
**/node_modules
.git
.next
**/.next
**/dist
**/build
**/coverage
**/.turbo
**/*.tsbuildinfo
**/.vercel
**/*.log
# `.env*` alone matches only the context ROOT, so a package's `.env` would be
# copied into the image — a developer's local secrets baked into a layer.
.env*
**/.env
**/.env.*
!.env.example
!**/.env.example
.obsidian
.claude
/tmp
target
**/target
# Not inputs to this image: the planning folders and the agents' transient
# state. `target` and `**/target` above are the Rust build output, which is
# gigabytes on a developer's machine.
plans
.superpowers
.github
**/.DS_Store
