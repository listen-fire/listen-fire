# The API's development environment. Copy to `apps/api/.env` and fill in.
#
#   cp apps/api/.env.example apps/api/.env
#
# The dev loop does NOT generate this file: `dev/loop.sh` reads it and warns
# when it is missing a value, but it never writes one. Every URL and port the
# loop needs it exports for itself, so what is left here is the handful of
# things it cannot invent — the database it connects to, and the secrets that
# have to stay the same between runs or the data written under them stops being
# readable.
#
# This file is for LOCAL DEVELOPMENT ONLY. A self-hosted installation is
# configured through `deploy/.env` instead (see deploy/SELF_HOSTING.md), and
# mints its own secrets on first boot rather than taking them from a file.

NODE_ENV=development

# ------------------------------------------------------------- database ---
# `dev/docker-compose.yml` (brought up by `pnpm dev:loop`) publishes Postgres
# on 9432 with these credentials. Nothing local has a read replica, so the
# readonly URL is the same connection — it is required rather than optional
# because production has two and the code will not guess.
DATABASE_URL=postgresql://listenfire:localdevpassword@localhost:9432/listenfire
DATABASE_URL_READONLY=postgresql://listenfire:localdevpassword@localhost:9432/listenfire

# The database the integration tests migrate and write to. It must be a
# DIFFERENT database from the one above: the harness applies migrations to it
# and the suites write freely, so pointing it at your dev-loop database loses
# your dev-loop state. Create it once with
# `createdb -h localhost -p 9432 -U listenfire listenfire_test`.
# Unit tests need neither of these — see CONTRIBUTING.md, "Tests".
DATABASE_URL_TEST=postgresql://listenfire:localdevpassword@localhost:9432/listenfire_test
DATABASE_URL_TEST_READONLY=postgresql://listenfire:localdevpassword@localhost:9432/listenfire_test

# -------------------------------------------------------------- secrets ---
# Generate your own, once, and then leave them alone:
#
#   TOKEN_SECRET           openssl rand -base64 32
#   ENCRYPTION_MASTER_KEY  openssl rand -base64 32
#   ENCRYPTION_SALT_BASE64 openssl rand -base64 32
#
# The two encryption values are a one-way door even locally: every stored
# third-party credential is encrypted under them, so changing either makes the
# connections in your dev database permanently unreadable and they have to be
# made again. The values below are inert placeholders — replace them before
# storing anything you would mind losing.
TOKEN_SECRET=local-development-token-secret-not-a-real-one
ENCRYPTION_MASTER_KEY=bG9jYWwtZGV2ZWxvcG1lbnQtbWFzdGVyLWtleS0zMmI=
ENCRYPTION_SALT_BASE64=bG9jYWwtZGV2ZWxvcG1lbnQtaGtkZi1zYWx0LTMyYnk=

# The audience claim on a session token. Any opaque string; changing it signs
# out every session already minted against the old one.
SESSION_JWT_AUDIENCE=listen-fire-dev

# ------------------------------------------------------------- dev loop ---
# The team `pnpm dev:seed` provisions, pinned so it survives a re-seed. It is
# also the switch that routes the real adapters at the fake third parties
# (`apps/fake-channels`) instead of at Slack, Attio and the rest — without it
# the loop boots but nothing is faked, which is what `dev:loop`'s warning is
# about. Any UUID of your own.
TEST_HARNESS_TEAM_ID=11111111-2222-3333-4444-555555555555

# The identity unauthenticated `/api/public/*` routes act as. `dev:seed`
# provisions this exact user, so leave it as it is unless you know why.
PUBLIC_USER_ID=40087837-1509-4eeb-935d-ce004ca4a5c7

# --------------------------------------------------------------- models ---
# Not needed to boot: every model client reads its key lazily and falls back to
# an inert value in development. A real key is what makes the agents actually
# answer — `pnpm dev:chat`, extraction, and the arbitration worker.
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# -------------------------------------------------------- integrations ---
# All optional. The dev loop serves Slack, Attio, Affinity, Airtable, Google
# Sheets and Drive, Granola, email, WhatsApp and Telegram from
# `apps/fake-channels`, so none of these is needed to exercise an integration
# end to end. Set a pair only to talk to the real third party.
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
# SLACK_SIGNING_SECRET=
# ATTIO_CLIENT_ID=
# ATTIO_CLIENT_SECRET=
# AIRTABLE_CLIENT_ID=
# AIRTABLE_CLIENT_SECRET=
# GOOGLE_INTEGRATIONS_CLIENT_ID=
# GOOGLE_INTEGRATIONS_CLIENT_SECRET=
