import { kg } from adapters
import { `Dev Loop Knowledge` } from credentials

graph = kg(credentials: `Dev Loop Knowledge`)

movement kg_echo_probe(change: <graph-[:`Record Change` WHERE `type` == "Organisation" AND `action` == "record.created"]->>) {
  change-[org:Record]-> {
    write graph-[:Person]-> {
      Name: "Echo Guard ${org.Name}"
    }
  }
}

listen to graph { type: "Organisation", events: ["record.created"], suppress_self: true } fire kg_echo_probe
