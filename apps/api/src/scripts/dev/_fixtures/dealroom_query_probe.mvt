import { manual, dealroom, slack } from adapters
import { `Dev Loop Dealroom`, `Dev Loop Slack` } from credentials

runs = manual()
dr   = dealroom(credentials: `Dev Loop Dealroom`)
chat = slack(credentials: `Dev Loop Slack`)

movement dealroom_query_probe(go: <runs-[:Invocation]->>) {
  chat-[ch:Channels WHERE `Name` == "dealflow"]-> {
    dr-[byName:Companies WHERE `Name` == "Nimbusly"]-> {
      rounds  = JOIN(byName-[r:`Funding Rounds` ORDER BY `Date` ASC]->.`Round`, ", ")
      backers = JOIN(byName-[i:Investors ORDER BY `Name` ASC]->.`Name`, ", ")
      team    = JOIN(byName-[t:Team ORDER BY `Name` ASC]->.`Name`, ", ")
      write ch-[:Messages]-> {
        Message: "by name: ${byName.`Name`} (${byName.`Website URL`}) rounds=[${rounds}] investors=[${backers}] team=[${team}]"
      }
    }

    dr-[byDomain:Companies WHERE `Website URL` CONTAINS "vaultwise.de"]-> {
      write ch-[:Messages]-> {
        Message: "by domain: ${byDomain.`Name`} (${byDomain.`Website URL`}) funding=${byDomain.`Total Funding`}"
      }
    }

    byIndustry = JOIN(dr-[c:Companies WHERE `Industries` CONTAINS "HealthTech" ORDER BY `Name` ASC]->.`Name`, ", ")
    write ch-[:Messages]-> {
      Message: "by industry HealthTech: ${byIndustry}"
    }

    topFunded = JOIN(dr-[c2:Companies ORDER BY `Total Funding` DESC LIMIT 3]->.`Name`, ", ")
    write ch-[:Messages]-> {
      Message: "top funded: ${topFunded}"
    }

    byCity = JOIN(dr-[c3:Companies WHERE `HQ Country` == "Germany" ORDER BY `Name` ASC]->.`HQ City`, ", ")
    write ch-[:Messages]-> {
      Message: "HQ in Germany: ${byCity}"
    }

    dr-[inv:Investors WHERE `Name` == "Northbridge Ventures"]-> {
      funds = JOIN(inv-[f:Funds ORDER BY `Name` ASC]->.`Name`, ", ")
      write ch-[:Messages]-> {
        Message: "investor ${inv.`Name`} funds=[${funds}]"
      }
    }

    dr-[co:Companies WHERE `Name` == "Nimbusly"]-> {
      co-[tm:Team]-> {
        tm-[p:Person]-> {
          write ch-[:Messages]-> {
            Message: "team member ${tm.`Name`} -> person ${p.`Name`} (founder score ${p.`Founder Score`})"
          }
        }
      }
    }
  }
}

listen to runs {} fire dealroom_query_probe
