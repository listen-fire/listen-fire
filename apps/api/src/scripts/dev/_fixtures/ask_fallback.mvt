import { manual, attio, slack, ask } from adapters
import { `Dev Loop Attio`, `Dev Loop Slack` } from credentials

runs = manual()
crm  = attio(credentials: `Dev Loop Attio`)
chat = slack(credentials: `Dev Loop Slack`)
asks = ask()

# Timeout, reminder and escalation are COMPOSED from race + sleep: one arm waits
# for the answer and hands it back, the other posts a reminder at 10s and holds
# the deadline to 20s. Only the arm that settles first fills its slot, so a null
# first slot IS the timeout branch.
movement ask_fallback_demo(go: <runs-[:Invocation]->>) {
  q = write asks-[:Check]-> { Prompt: "Pursue this deal?" }
  chat-[ch:Channels WHERE `Name` == "dealflow"]-> {
    write ch-[:Messages]-> { Message: "Pursue? answer here: ${q.Url}" }
  }

  r = await race([
    () => {
      a = await FIRST(q-[:Response]->)
      return a.Answer
    },
    () => {
      await sleep(10s)
      chat-[ch2:Channels WHERE `Name` == "portfolio"]-> {
        write ch2-[:Messages]-> { Message: "Still need you — reminder: ${q.Url}" }
      }
      await sleep(10s)
    },
  ])

  decision = AT(r, 0)
  if decision == TRUE {
    write crm-[:Companies]-> { unique by (`Domains`), Domains: "pursued.example", Name: "PURSUED" }
  }
  if decision == FALSE {
    write crm-[:Companies]-> { unique by (`Domains`), Domains: "declined.example", Name: "DECLINED" }
  }
  if decision == null {
    write crm-[:Companies]-> { unique by (`Domains`), Domains: "timedout.example", Name: "TIMED-OUT-DEFAULT-FALSE" }
  }
}

listen to runs {} fire ask_fallback_demo
