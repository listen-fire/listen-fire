import { manual, kg } from adapters
import { `Dev Loop Knowledge` } from credentials

runs = manual()
graph = kg(credentials: `Dev Loop Knowledge`)

movement kg_write_probe(go: <runs-[:Invocation]->>) {
  write graph-[:Organisation]-> {
    Name: "Probe Industries"
    Website: "https://probe.example"
    Sector: "Testing"
  }
}

listen to runs {} fire kg_write_probe
