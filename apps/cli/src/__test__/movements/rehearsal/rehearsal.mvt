import { acme_crm } from adapters
import { acme } from credentials

crm = connect acme_crm using acme

# A company created in the CRM is written, refreshed, sleeps and is
# refreshed again: under --dry-run, the sleep is passed and every write rehearses.
function rehearse(company: <crm-[:Company]->>) {
  co = write crm-[:Company]-> { Name: "Rehearsed" }
  refresh co
  await sleep(1s)
  refresh co
  write crm-[:Company]-> { Name: "After ${co.Name}" }
}

listen to crm {} fire rehearse
