import { acme_crm } from adapters
import { acme } from credentials

crm = connect acme_crm using acme

# Run by hand, a company is written, refreshed, sleeps and is refreshed
# again: under --dry-run, the sleep is passed and every write rehearses.
function rehearse(go: <manual-[:Invocations]->>) {
  co = write crm-[:Company]-> { Name: "Rehearsed" }
  refresh co
  await sleep(1s)
  refresh co
  write crm-[:Company]-> { Name: "After ${co.Name}" }
}

listen to manual-[:Invocations]-> fire rehearse
