import { acme_crm } from adapters
import { acme } from credentials

crm = connect acme_crm using acme

# A company created in the CRM opens a decision record and waits a day for
# the decision on it; the sleep arm is the timeout.
function approve(company: <crm-[:Company]->>) {
  ask = write crm-[:Company]-> { Name: "Decide ${company.Name}" }
  r = race(
    () => {
      a = await ask-[:Approvals]->
      return a.Decision
    },
    () => { await sleep(1d) },
  )
  if (r[0] == null) {
    write crm-[:Company]-> { Name: "Timed out" }
  }
  if (r[0] != null) {
    write crm-[:Company]-> { Name: "Approved ${r[0]}" }
  }
}

listen to crm-[:Company]-> fire approve
