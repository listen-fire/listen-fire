{
  "name": "lf-cli",
  "private": true,
  "license": "Apache-2.0",
  "version": "0.0.1",
  "description": "Test harness for the `lf` binary (crates/lf): drives the built binary against the example project. Contains no lf runtime.",
  "engines": {
    "node": "22.23.4"
  },
  "scripts": {
    "code:type-check": "tsc --pretty --noEmit",
    "test": "node --conditions=movement-engine-internals --test --require tsx/cjs src/__test__/*.test.ts"
  },
  "type": "commonjs",
  "dependencies": {
    "@listen-fire/fake-channels": "workspace:^",
    "engine-contracts": "workspace:@listen-fire/engine-contracts@*",
    "module-kit": "workspace:@listen-fire/module-kit@*",
    "movement-engine": "workspace:@listen-fire/engine@*",
    "tsx": "4.21.0",
    "yaml": "2.5.0",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/node": "22.19.15",
    "@types/pg": "8.11.9",
    "pg": "8.12.0",
    "typescript": "5.5.4"
  }
}
